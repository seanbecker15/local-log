{
  "name": "tiny-log-mcp",
  "version": "0.8.0",
  "description": "Ephemeral local log collector with an MCP server, so coding agents can read what your app printed — browser, device, or backend — with high signal-to-noise filtering.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tiny-log-mcp": "bin/tiny-log-mcp.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "public"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/tiny-log-mcp.js serve",
    "dev": "node --watch bin/tiny-log-mcp.js serve",
    "mcp": "node bin/tiny-log-mcp.js",
    "test": "node --test",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "keywords": [
    "mcp",
    "logs",
    "logging",
    "claude",
    "agent",
    "devtools",
    "console"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanbecker15/tiny-log-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "homepage": "https://github.com/seanbecker15/tiny-log-mcp#readme",
  "bugs": {
    "url": "https://github.com/seanbecker15/tiny-log-mcp/issues"
  }
}
